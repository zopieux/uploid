{
  description = "uploid - upload your images";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    flake-utils.url = "github:numtide/flake-utils";
  };

  outputs =
    {
      self,
      nixpkgs,
      flake-utils,
    }:
    flake-utils.lib.eachDefaultSystem (
      system:
      let
        pkgs = import nixpkgs {
          inherit system;
          config.allowUnfree = true;
          config.android_sdk.accept_license = true;
        };

        buildToolsVersion = "35.0.0";
        jdk = pkgs.jdk17;

        android = pkgs.androidenv.composeAndroidPackages {
          cmdLineToolsVersion = "11.0";
          platformToolsVersion = "35.0.2";
          buildToolsVersions = [ buildToolsVersion ];
          platformVersions = [ "35" ];
          includeNDK = false;
          includeEmulator = false;
          includeSystemImages = false;
        };
        androidSdk = android.androidsdk;
      in
      {
        packages.default = pkgs.stdenv.mkDerivation {
          pname = "uploid";
          version = "1.0";

          src = self;

          nativeBuildInputs = [
            androidSdk
            jdk
          ];

          ANDROID_HOME = "${androidSdk}/libexec/android-sdk";
          ANDROID_SDK_ROOT = "${androidSdk}/libexec/android-sdk";
          JAVA_HOME = "${jdk}";
          GRADLE_OPTS = "-Dorg.gradle.project.android.aapt2FromMavenOverride=${androidSdk}/libexec/android-sdk/build-tools/${buildToolsVersion}/aapt2";

          buildPhase = ''
            runHook preBuild
            patchShebangs gradlew
            export HOME=$(mktemp -d)
            export GRADLE_USER_HOME=$(mktemp -d)
            export SOURCE_DATE_EPOCH=1700000000
            mkdir -p "$HOME/.android"
            cp gradle/debug.keystore "$HOME/.android/debug.keystore"
            cat <<EOF > local.properties
            sdk.dir=$ANDROID_HOME
            EOF

            ./gradlew --no-daemon assembleRelease
            runHook postBuild
          '';

          installPhase = ''
            runHook preInstall
            mkdir -p $out
            cp app/build/outputs/apk/release/app-release.apk $out/uploid-release.apk
            runHook postInstall
          '';

          outputHashAlgo = "sha256";
          outputHashMode = "recursive";
          outputHash = "sha256-/r9FrfZjdt0+TJS0MurtvY/U0qHy/0zqwFieO+WjliA=";
        };

        devShells.default = pkgs.mkShell rec {
          buildInputs = [
            androidSdk
            jdk
            pkgs.gradle
            pkgs.kotlin
            pkgs.ktlint
          ];

          ANDROID_HOME = "${androidSdk}/libexec/android-sdk";
          ANDROID_SDK_ROOT = "${androidSdk}/libexec/android-sdk";
          JAVA_HOME = "${jdk}";
          GRADLE_OPTS = "-Dorg.gradle.project.android.aapt2FromMavenOverride=${ANDROID_SDK_ROOT}/build-tools/${buildToolsVersion}/aapt2";

          # Gradle needs a writable home.
          shellHook = ''
            export GRADLE_USER_HOME="''${GRADLE_USER_HOME:-$HOME/.gradle}"
            cat <<EOF > local.properties
            # Auto-generated by Nix flake devShell.
            sdk.dir=$ANDROID_HOME
            EOF
          '';
        };
      }
    );
}
